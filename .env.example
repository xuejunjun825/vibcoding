# ---------------------------------------------------------------------------
# DevOps 研发管理平台 — 环境变量样例
#
# 复制为 .env 后按需修改（.env 不入库，见 .gitignore）。scripts/platform-up.sh
# 会读取 .env；未提供的变量一律走 application.yml 里的默认值。
# ---------------------------------------------------------------------------

# ---- 数据库（req-service 持有唯一迁移者，deliver-service 只读同一库）----
PLATFORM_DB_URL=jdbc:mysql://127.0.0.1:3306/devops_platform?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
PLATFORM_DB_USER=root
PLATFORM_DB_PASSWORD=

# ---- 端口 ----
REQ_PORT=8082
DELIVER_PORT=8083
WEB_PORT=5173
GATEWAY_PORT=8080
NACOS_SERVER_ADDR=127.0.0.1:8848

# ---- 安全 ----
# JWT 签名密钥（HS256，至少 32 字节；生产环境必须替换）
PLATFORM_JWT_SECRET=dev-only-jwt-secret-please-change-32bytes-min
# 服务间调用口令（X-Internal-Token），req/deliver 两端必须一致
PLATFORM_INTERNAL_TOKEN=dev-internal-token
# 开放 API 密钥的可逆存储主密钥（AES-GCM，Base64；与 scripts/lib.sh 默认值一致）
PLATFORM_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcy1sb25nISE=

# ---- 开放 API ----
# 允许的时钟偏移（秒）与单客户端限流（每秒请求数）
PLATFORM_OPENAPI_SKEW_SECONDS=300
PLATFORM_OPENAPI_QPS=20

# ---- 行为开关 ----
# 启动时是否执行幂等种子（首次起栈置 true，之后可置 false）
PLATFORM_SEED_ENABLED=true
# 未显式指定门禁模式时的默认值：STRICT | LOOSE
PLATFORM_GATE_DEFAULT_MODE=STRICT
