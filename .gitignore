# ---- TeamFlow runtime logs (plugin-owned, must stay ignored) ----
logs/teamflow/

# ---- Java / Maven ----
target/
*.class
*.jar
.flattened-pom.xml
.mvn/timing.properties

# ---- Nacos distribution, downloaded archive and runtime data ----
.nacos/

# ---- Local run state (pid files) & sandbox Maven repo fallback ----
.run/
.m2/

# ---- Logs and local env ----
logs/
*.log
.env
.env.local
.env.*
!.env.example

# ---- Frontend build artifacts & package stores (platform layer) ----
node_modules/
dist/
.vite/
.pnpm-store/
coverage/
*.tsbuildinfo

# ---- Local volatile state / heap dumps ----
var/
*.hprof

# ---- M7 integration stub runtime (make integration-verify) ----
# 桩进程的 pid/日志与测试产物都是每次重跑可再生，入库只会制造噪音与冲突。
scripts/tests/integration/.stub-run/
*.pid
test-results/
playwright-report/

# ---- M9 报表导出产物（20261110-r9 /reports/{id}/export 的下载件） ----
# 手工点一次导出就会在项目根留下 报表-*.xlsx / *.csv；两者都是二进制或可再生的验证残留
# （git ls-files 里没有任何 .xlsx/.csv，安全），跑一次导出就让 git status 变脏是纯噪音。
*.xlsx
*.csv

# ---- IDE ----
.idea/
*.iml
*.ipr
.vscode/
.settings/
.classpath
.project

# ---- macOS ----
.DS_Store

# ---- Workspace-local gh CLI config (pre-existing rule) ----
.ghconfig/

# ---- MUST stay tracked (never add: config/nacos/ 种子配置, pom.xml, scripts/, docs/) ----
# config/nacos/demo-service.yml 是 AC-3 的唯一合法配置来源，忽略它会让 dev-up 发布空配置。
