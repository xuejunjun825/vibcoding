{
  "name": "devops-platform-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DevOps 研发管理平台前端（Vue 3 + Element Plus + Vite）",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
